---
import CaseStudyLayout from '../../components/CaseStudyLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import MetricCard from '../../components/MetricCard.astro';
import CreativeCard from '../../components/CreativeCard.astro';
import InsightCard from '../../components/InsightCard.astro';
---

<CaseStudyLayout title="ThePetNest - Simulated Case Study">
  
  {/* Hero Section */}
  <section class="relative h-[85vh] min-h-[650px] mb-12 rounded-sm overflow-hidden border-2 border-[var(--red-dark)] group shadow-2xl">
    <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg)] via-[var(--bg)]/80 to-[var(--red-dark)]/50 z-10"></div>
    
    {/* Background Pattern */}
    <div class="absolute inset-0 bg-[var(--panel)] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 opacity-10 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0MCIgaGVpZ2h0PSI0MCI+CiAgPHJlY3Qgd2lkdGg9IjQwIiBoZWlnaHQ9IjQwIiBmaWxsPSJub25lIi8+CiAgPHBhdGggZD0iTTAgMGw0MCA0ME00MCAwbC00MCA0MCIgc3Ryb2tlPSIjRTMyOTM4IiBzdHJva2Utd2lkdGg9IjAuNSIvPgo8L3N2Zz4=')] bg-repeat"></div>
      
      {/* Abstract pet care / data visual */}
      <div class="relative w-full h-full flex flex-col items-center justify-center opacity-30 gap-6">
        <div class="w-64 h-32 border-2 border-dashed border-[var(--red)] rounded-t-full"></div>
        <div class="flex gap-4">
          <div class="w-16 h-16 bg-[var(--red-dark)] rounded-full border border-[var(--red)]"></div>
          <div class="w-16 h-16 bg-[var(--red-dark)] rounded-full border border-[var(--red)]"></div>
          <div class="w-16 h-16 bg-[var(--red-dark)] rounded-full border border-[var(--red)]"></div>
        </div>
      </div>
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 font-mono text-sm md:text-lg text-[var(--red-bright)] tracking-widest bg-black/70 px-8 py-4 border border-[var(--red-dark)] backdrop-blur-md whitespace-nowrap shadow-xl">[ BRAND AWARENESS VISUAL ]</div>
    </div>
    
    <div class="absolute inset-0 z-20 flex flex-col justify-end p-8 md:p-16 lg:p-24">
      <span class="inline-block px-5 py-2 bg-[var(--red-dark)] text-white font-mono text-[11px] md:text-sm mb-10 w-max tracking-widest border border-[var(--red)] shadow-sm uppercase">Simulated Project / Google Ads</span>
      <h1 class="font-pixel text-[clamp(1.8rem,6.5vw,3.75rem)] text-white mb-8 leading-[1.2] tracking-tight drop-shadow-lg">THEPETNEST</h1>
      <h2 class="font-sans text-[22px] text-white mb-6 font-bold tracking-wide">Google Ads Top-of-Funnel Campaign Strategy</h2>
      <p class="text-lg md:text-[19px] text-[var(--text-secondary)] max-w-3xl font-sans mb-14 leading-[1.8] drop-shadow-md">
        A simulated paid-media strategy for introducing ThePetNest to new and relevant pet owners in major Indian urban markets.
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 font-mono text-[12px] md:text-[13px] border-t border-[var(--red-dark)] pt-10">
        <div>
          <span class="block text-[var(--text-muted)] mb-2 tracking-widest uppercase">Project Type</span>
          <span class="text-[var(--text-primary)]">Simulated campaign</span>
        </div>
        <div>
          <span class="block text-[var(--text-muted)] mb-2 tracking-widest uppercase">Campaign Stage</span>
          <span class="text-[var(--text-primary)]">Top of Funnel / Awareness</span>
        </div>
        <div>
          <span class="block text-[var(--text-muted)] mb-2 tracking-widest uppercase">Market</span>
          <span class="text-[var(--text-primary)]">Major urban markets in India</span>
        </div>
      </div>
    </div>
  </section>

  <div class="mb-12 font-sans text-[14px] text-[var(--text-muted)] bg-[var(--panel)] p-6 border-l-4 border-l-[var(--red-bright)] leading-relaxed">
    <strong>Important:</strong> This case study contains proposed strategy and planning assumptions only. It does not represent a live client engagement, live media spend, or actual campaign results.
  </div>

  {/* Player / Campaign Identity Panel */}
  <section class="section pt-0">
    <div class="pixel-panel p-10 md:p-16 flex flex-col lg:flex-row gap-16 items-center lg:items-start shadow-2xl shadow-[var(--red-dark)]/20 border-t-[6px] border-t-[var(--red)] border-l-0 bg-[var(--burgundy)]">
      
      <div class="w-56 h-56 md:w-64 md:h-64 shrink-0 bg-black border-2 border-[var(--red-dark)] relative overflow-hidden group">
        <img src="/pixel-assets/operator-avatar.jpg" alt="Kanishk Prabhat - Campaign Operator" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
        <div class="absolute inset-0 bg-[var(--red)]/10 mix-blend-overlay pointer-events-none"></div>
      </div>
      
      <div class="flex-grow flex flex-col justify-center pt-2 w-full">
        <div class="font-mono text-[var(--text-muted)] text-[11px] md:text-[12px] mb-4 tracking-widest">STRATEGY ARCHITECT</div>
        <h2 class="font-pixel text-2xl md:text-3xl text-[var(--text-primary)] mb-6 tracking-wide drop-shadow-sm">KANISHK PRABHAT</h2>
        <div class="font-mono text-[var(--red-bright)] text-sm md:text-base mb-12 tracking-widest leading-[1.8]">PAID MEDIA STRATEGY & PLANNING</div>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 pt-10 border-t border-[var(--red-dark)]">
          <div>
            <div class="font-mono text-[11px] text-[var(--text-muted)] mb-3 tracking-widest uppercase">STATUS</div>
            <div class="font-mono text-[13px] md:text-sm text-[var(--text-primary)] flex items-center gap-3 tracking-wide">
              <span class="w-2.5 h-2.5 rounded-full bg-[var(--text-muted)]"></span> SIMULATED
            </div>
          </div>
          <div>
            <div class="font-mono text-[11px] text-[var(--text-muted)] mb-3 tracking-widest uppercase">SYSTEM</div>
            <div class="font-mono text-[13px] md:text-sm text-[var(--text-primary)] tracking-wide">GOOGLE ADS</div>
          </div>
          <div>
            <div class="font-mono text-[11px] text-[var(--text-muted)] mb-3 tracking-widest uppercase">MISSION</div>
            <div class="font-mono text-[13px] md:text-sm text-[var(--text-primary)] tracking-wide leading-relaxed">BUILD AWARENESS</div>
          </div>
        </div>
      </div>
      
    </div>
  </section>

  {/* Business Context & Objective */}
  <section class="section">
    <SectionHeading index="01" title="Business Context" />
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 md:gap-24 mb-16">
      <div>
        <div class="prose prose-invert prose-p:text-[var(--text-secondary)] prose-p:font-sans prose-p:text-[15px] prose-p:leading-[1.75] max-w-none">
          <p>ThePetNest is a pet-care platform offering services including online veterinary consultations, grooming, boarding, dog walking, training, pet insurance and other pet-care solutions.</p>
          <p>The campaign challenge was to introduce the platform to relevant pet owners before they reached the final booking stage. The strategy therefore focused on building awareness and consideration while creating a pool of users that could later support remarketing and conversion activity.</p>
        </div>
        <div class="mt-10 p-8 border-l-4 border-l-[var(--red)] bg-[var(--panel)]">
          <p class="font-sans text-[18px] text-[var(--text-primary)] font-bold leading-relaxed">
            The strategic question was: How can paid media make ThePetNest relevant to a pet owner who may not yet know the brand, but has a current or emerging pet-care need?
          </p>
        </div>
      </div>
      <div class="pixel-panel p-10 md:p-12 bg-[var(--panel)] border-l-4 border-l-[var(--red-dark)] border-t-0 border-r-0 border-b-0">
        <h3 class="font-mono text-lg text-[var(--text-primary)] mb-8 tracking-wider uppercase">Campaign Objective</h3>
        <div class="mb-8 pb-8 border-b border-[var(--red-dark)]">
          <p class="font-sans text-[15px] text-[var(--text-secondary)] leading-[1.75]">
            <strong class="text-white block mb-2">Primary objective:</strong> Build awareness among new and relevant pet owners in major Indian urban markets.
          </p>
        </div>
        
        <strong class="text-white font-sans block mb-4">Secondary objectives:</strong>
        <ul class="space-y-4 font-sans text-[15px] text-[var(--text-secondary)] leading-[1.75] list-disc pl-5">
          <li>Generate cost-efficient reach and repeated exposure.</li>
          <li>Introduce ThePetNest's broader pet-care proposition.</li>
          <li>Encourage users to explore the platform.</li>
          <li>Identify audience and creative signals that can inform later funnel stages.</li>
          <li>Build remarketing pools from relevant site visitors and engaged users.</li>
        </ul>
      </div>
    </div>
  </section>

  {/* Audience Strategy */}
  <section class="section">
    <SectionHeading index="02" title="Audience Strategy" />
    <p class="font-sans text-[16px] text-[var(--text-secondary)] leading-[1.8] max-w-4xl mb-10">
      I developed audience hypotheses across broad interest, category interest and more specific intent signals. The purpose was to avoid treating every pet owner as having the same level of need or purchase intent.
    </p>
    
    <div class="pixel-panel overflow-x-auto border border-[var(--red-dark)] mb-10">
      <table class="w-full text-left font-sans text-[14px]">
        <thead>
          <tr class="bg-[var(--red-dark)] text-white uppercase font-mono tracking-widest text-[12px]">
            <th class="p-5 border-b border-[var(--red)]">Segment</th>
            <th class="p-5 border-b border-[var(--red)]">Signal / Approach</th>
            <th class="p-5 border-b border-[var(--red)]">Strategic Role</th>
          </tr>
        </thead>
        <tbody class="text-[var(--text-secondary)] divide-y divide-[var(--red-dark)] bg-[var(--burgundy)]">
          <tr class="hover:bg-[var(--panel)] transition-colors">
            <td class="p-5 font-bold text-[var(--text-primary)]">Pet Lovers</td>
            <td class="p-5 font-mono text-[12px]">Affinity</td>
            <td class="p-5">Broad awareness and discovery</td>
          </tr>
          <tr class="hover:bg-[var(--panel)] transition-colors">
            <td class="p-5 font-bold text-[var(--text-primary)]">Family-Focused</td>
            <td class="p-5 font-mono text-[12px]">Affinity</td>
            <td class="p-5">Connect pet care with household convenience</td>
          </tr>
          <tr class="hover:bg-[var(--panel)] transition-colors">
            <td class="p-5 font-bold text-[var(--text-primary)]">Pet Care & Services</td>
            <td class="p-5 font-mono text-[12px]">In-market</td>
            <td class="p-5">Reach users already interested in pet-care categories</td>
          </tr>
          <tr class="hover:bg-[var(--panel)] transition-colors">
            <td class="p-5 font-bold text-[var(--text-primary)]">Pet Supplies & Food</td>
            <td class="p-5 font-mono text-[12px]">In-market</td>
            <td class="p-5">Identify existing pet owners and category participants</td>
          </tr>
          <tr class="hover:bg-[var(--panel)] transition-colors">
            <td class="p-5 font-bold text-[var(--text-primary)]">Pet Care Researchers</td>
            <td class="p-5 font-mono text-[12px]">Custom intent</td>
            <td class="p-5">Reach users showing more specific service-related intent</td>
          </tr>
          <tr class="hover:bg-[var(--panel)] transition-colors">
            <td class="p-5 font-bold text-[var(--text-primary)]">New Pet Parents</td>
            <td class="p-5 font-mono text-[12px]">Custom intent</td>
            <td class="p-5">Reach users early in their pet-parenting journey</td>
          </tr>
        </tbody>
      </table>
    </div>
    
    <div class="bg-[var(--panel)] p-8 border-l-2 border-[var(--red-bright)]">
      <p class="font-sans text-[15px] text-[var(--text-secondary)] leading-[1.8]">
        The strongest audience hypothesis was the use of service-specific intent signals. Examples included searches such as "dog grooming near me," "pet boarding near me," "online vet consultation," "vet at home," and "dog walker near me."
      </p>
    </div>
  </section>

  {/* Geographic Strategy */}
  <section class="section border-t border-[var(--red-dark)] pt-16">
    <SectionHeading index="03" title="Geographic & Demographic" />
    <p class="font-sans text-[16px] text-[var(--text-secondary)] leading-[1.8] max-w-4xl mb-6">
      <strong>Target markets:</strong> Delhi-NCR, Mumbai, Bengaluru, Hyderabad, Chennai, Pune, Kolkata and Ahmedabad.
    </p>
    <p class="font-sans text-[16px] text-[var(--text-secondary)] leading-[1.8] max-w-4xl mb-12">
      These major urban markets were selected as an initial test set where organized pet-care demand and service availability were expected to be stronger. Geographic performance would then be evaluated rather than treating the initial city selection as a permanent assumption.
    </p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      <div class="bg-[var(--burgundy)] p-6 border border-[var(--red-dark)]">
        <div class="font-mono text-[var(--red-bright)] text-sm mb-2 tracking-widest uppercase">Age: 25-44</div>
        <p class="font-sans text-[14px] text-[var(--text-secondary)] leading-relaxed">Initial working-age audience hypothesis; kept broad enough for testing.</p>
      </div>
      <div class="bg-[var(--burgundy)] p-6 border border-[var(--red-dark)]">
        <div class="font-mono text-[var(--red-bright)] text-sm mb-2 tracking-widest uppercase">Gender: All</div>
        <p class="font-sans text-[14px] text-[var(--text-secondary)] leading-relaxed">No strong strategic reason to exclude either gender.</p>
      </div>
      <div class="bg-[var(--burgundy)] p-6 border border-[var(--red-dark)]">
        <div class="font-mono text-[var(--red-bright)] text-sm mb-2 tracking-widest uppercase">Parents + Non-parents</div>
        <p class="font-sans text-[14px] text-[var(--text-secondary)] leading-relaxed">Human-parent status is not a reliable proxy for pet-parent status.</p>
      </div>
      <div class="bg-[var(--burgundy)] p-6 border border-[var(--red-dark)]">
        <div class="font-mono text-[var(--red-bright)] text-sm mb-2 tracking-widest uppercase">Upper Income Tiers</div>
        <p class="font-sans text-[14px] text-[var(--text-secondary)] leading-relaxed">Initial hypothesis for users with greater capacity for paid pet-care services.</p>
      </div>
    </div>
    
    <div class="bg-[var(--panel)] p-6 border border-[var(--red-dark)]">
      <p class="font-sans text-[14px] text-[var(--text-muted)] leading-relaxed">
        <strong>Device principle:</strong> Mobile would be expected to carry substantial discovery volume, while desktop would remain important for users who spend longer researching services. Tablet performance would be monitored rather than assumed.
      </p>
    </div>
  </section>

  {/* Creative Strategy */}
  <section class="section">
    <SectionHeading index="04" title="Creative Strategy" />
    <p class="font-sans text-[16px] text-[var(--text-secondary)] leading-[1.8] max-w-4xl mb-10">
      The creative strategy was built around three user problems rather than simply listing ThePetNest's services.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
      <CreativeCard 
        name="New Pet Parent" 
        category="AWARENESS" 
        description="ThePetNest supports new pet parents from the beginning. ('First-Time Pet Parent? We've Got You')" 
        placeholderText="PUPPY VISUAL" 
        patternIndex={1}
        funnelRole="Problem: I don't know where to start."
      />
      <CreativeCard 
        name="Convenience" 
        category="CONSIDERATION" 
        description="Book pet care around your schedule. ('Pet Care That Fits Your Schedule')" 
        placeholderText="SCHEDULE UI" 
        patternIndex={2}
        funnelRole="Problem: Pet care is difficult to fit into my schedule."
      />
      <CreativeCard 
        name="One Platform" 
        category="TRUST" 
        description="Multiple pet-care needs in one platform. ('Every Pet Service, One Trusted Platform')" 
        placeholderText="BRAND MOSAIC" 
        patternIndex={3}
        funnelRole="Problem: I need different services from different places."
      />
    </div>
    <p class="font-sans text-[15px] text-[var(--text-muted)] mt-10 text-center">
      Together, they test whether the audience responds more strongly to onboarding reassurance, convenience, or breadth/trust.
    </p>
  </section>

  {/* Competitive Positioning & Landing Page */}
  <section class="section">
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-16">
      
      {/* Competitors */}
      <div>
        <SectionHeading index="05" title="Competitive Positioning" />
        <p class="font-sans text-[15px] text-[var(--text-secondary)] leading-[1.8] mb-8">
          I reviewed Supertails, Wiggles, Monkoodog, Heads Up For Tails and DogSpot to understand how established players position themselves.
        </p>
        <div class="flex flex-col gap-4 font-sans text-[14px]">
          <div class="bg-[var(--burgundy)] p-5 border-l-2 border-[var(--red-dark)]">
            <strong class="text-white block mb-1">Supertails</strong>
            <span class="text-[var(--text-secondary)]">Products + health / vet care &rarr; <em class="text-[var(--red-bright)] not-italic">Opportunity to emphasize service breadth</em></span>
          </div>
          <div class="bg-[var(--panel)] p-5 border-l-2 border-[var(--red-dark)]">
            <strong class="text-white block mb-1">Wiggles</strong>
            <span class="text-[var(--text-secondary)]">Boarding + health &rarr; <em class="text-[var(--red-bright)] not-italic">Differentiate through broader service convenience</em></span>
          </div>
          <div class="bg-[var(--burgundy)] p-5 border-l-2 border-[var(--red-dark)]">
            <strong class="text-white block mb-1">Monkoodog</strong>
            <span class="text-[var(--text-secondary)]">Hyperlocal daycare / boarding &rarr; <em class="text-[var(--red-bright)] not-italic">Position ThePetNest as a broader ecosystem</em></span>
          </div>
          <div class="bg-[var(--panel)] p-5 border-l-2 border-[var(--red-dark)]">
            <strong class="text-white block mb-1">Heads Up For Tails</strong>
            <span class="text-[var(--text-secondary)]">Premium products + brand &rarr; <em class="text-[var(--red-bright)] not-italic">Lean into service-first positioning</em></span>
          </div>
          <div class="bg-[var(--burgundy)] p-5 border-l-2 border-[var(--red-dark)]">
            <strong class="text-white block mb-1">DogSpot</strong>
            <span class="text-[var(--text-secondary)]">Community / information &rarr; <em class="text-[var(--red-bright)] not-italic">Emphasize movement from discovery to booking</em></span>
          </div>
        </div>
      </div>
      
      {/* Landing Page */}
      <div>
        <SectionHeading index="06" title="Landing Page Assessment" />
        <div class="prose prose-invert prose-p:text-[var(--text-secondary)] prose-p:font-sans prose-p:text-[15px] prose-p:leading-[1.75] max-w-none">
          <p>ThePetNest's website presents a clear pet-care proposition, visible service-specific CTAs and strong trust signals. Reviews, provider verification and service guarantees are particularly valuable for a category where trust influences booking decisions.</p>
          <p>The main friction I identified was the transition from cold awareness traffic into a relatively transactional booking journey. A user discovering the brand for the first time may need more context before committing to a booking flow.</p>
        </div>
        
        <div class="mt-8 p-8 border border-[var(--red)] bg-gradient-to-br from-[var(--red-dark)] to-black relative">
          <div class="absolute top-0 left-0 bg-[var(--red)] text-white text-[10px] font-mono px-2 py-1 tracking-widest uppercase">Recommendation</div>
          <p class="font-sans text-[16px] text-white leading-relaxed mt-4">
            Test a lighter first interaction for colder audiences, such as "New to ThePetNest? See how it works," while bringing stronger review and trust signals higher on the page and validating mobile load performance.
          </p>
        </div>
      </div>
      
    </div>
  </section>

  {/* Budget & Measurement */}
  <section class="section">
    <SectionHeading index="07" title="Budget & Measurement" />
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
      <div class="pixel-panel p-8 md:p-10 bg-[var(--panel)] border-[var(--red-dark)] border-2">
        <h3 class="font-mono text-[14px] text-white mb-6 tracking-widest uppercase border-b border-[var(--red-dark)] pb-4">Planning Assumptions</h3>
        <ul class="space-y-4 font-sans text-[14px] text-[var(--text-secondary)]">
          <li class="flex justify-between border-b border-[var(--red-dark)] pb-2">
            <span>Test budget</span> <strong class="text-white">₹3,000–₹4,000/day</strong>
          </li>
          <li class="flex justify-between border-b border-[var(--red-dark)] pb-2">
            <span>Monthly equivalent</span> <strong class="text-white">~₹90k–₹1.2 lakh</strong>
          </li>
          <li class="flex justify-between border-b border-[var(--red-dark)] pb-2">
            <span>Bidding philosophy</span> <strong class="text-white">Reach / CPM-oriented</strong>
          </li>
          <li class="flex justify-between border-b border-[var(--red-dark)] pb-2">
            <span>Frequency</span> <strong class="text-white">3–5 impressions/user/week</strong>
          </li>
        </ul>
        <p class="mt-6 text-[12px] text-[var(--text-muted)] italic">
          Rationale: Generate enough delivery across multiple audiences and creative variants to support meaningful testing before optimization.
        </p>
      </div>
      
      <div class="pixel-panel p-8 md:p-10 bg-[var(--burgundy)] border-[var(--red-dark)] border-2">
        <h3 class="font-mono text-[14px] text-white mb-6 tracking-widest uppercase border-b border-[var(--red-dark)] pb-4">Measurement Framework</h3>
        <ul class="space-y-5 font-sans text-[14px] text-[var(--text-secondary)]">
          <li>
            <strong class="text-[var(--red-bright)] block mb-1 text-[12px] uppercase tracking-wider">Delivery Layer</strong>
            Reach, impressions, frequency, CPM &rarr; <em>Delivering efficient awareness?</em>
          </li>
          <li>
            <strong class="text-[var(--red-bright)] block mb-1 text-[12px] uppercase tracking-wider">Engagement Layer</strong>
            CTR, CPC, engaged users, viewability &rarr; <em>Which combinations generate useful interactions?</em>
          </li>
          <li>
            <strong class="text-[var(--red-bright)] block mb-1 text-[12px] uppercase tracking-wider">Downstream Layer</strong>
            New users, branded search, remarketing pool growth &rarr; <em>Is awareness creating consideration?</em>
          </li>
        </ul>
      </div>
    </div>
  </section>

  {/* Optimization Framework */}
  <section class="section">
    <SectionHeading index="08" title="Optimization Framework" />
    <p class="font-sans text-[16px] text-[var(--text-secondary)] leading-[1.8] max-w-4xl mb-10">
      I would avoid making large changes based on isolated observations. Once sufficient data accumulated, optimization would focus on identifying repeatable differences across creative, audience, placement, device and geography.
    </p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6 font-sans text-[14px] text-[var(--text-secondary)]">
      <div class="border-t border-[var(--red-dark)] pt-4">
        <strong class="text-white block mb-1 font-mono text-[12px] tracking-widest uppercase">Creative</strong>
        Pause materially weak variants and develop new versions around the strongest messaging angle.
      </div>
      <div class="border-t border-[var(--red-dark)] pt-4">
        <strong class="text-white block mb-1 font-mono text-[12px] tracking-widest uppercase">Audience</strong>
        Shift budget toward segments showing the strongest combination of engagement and efficient delivery.
      </div>
      <div class="border-t border-[var(--red-dark)] pt-4">
        <strong class="text-white block mb-1 font-mono text-[12px] tracking-widest uppercase">Placements</strong>
        Identify high-volume, low-engagement inventory and exclude it where appropriate.
      </div>
      <div class="border-t border-[var(--red-dark)] pt-4">
        <strong class="text-white block mb-1 font-mono text-[12px] tracking-widest uppercase">Device</strong>
        Compare mobile, desktop and tablet performance and redistribute exposure when differences are meaningful.
      </div>
