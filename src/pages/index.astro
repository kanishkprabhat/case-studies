---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Portfolio - Case Studies">
  <div class="max-w-4xl mx-auto px-6 py-24 text-center">
    <h1 class="font-pixel text-3xl text-white mb-6">CASE STUDIES</h1>
    <p class="font-sans text-[var(--text-muted)] mb-12">Select a campaign mission control below.</p>
    <div class="flex flex-col md:flex-row flex-wrap items-center justify-center gap-6">
      <a href="/case-studies/dwell-construction" class="inline-block border border-[var(--red)] px-8 py-4 font-mono text-white hover:bg-[var(--red-dark)] transition-colors w-full md:w-auto tracking-widest text-sm text-center">
        INITIATE: DWELL CONSTRUCTION
      </a>
      <a href="/case-studies/thepetnest" class="inline-block border border-[var(--red)] px-8 py-4 font-mono text-white hover:bg-[var(--red-dark)] transition-colors w-full md:w-auto tracking-widest text-sm text-center">
        INITIATE: THEPETNEST
      </a>
      <a href="/case-studies/digital-marketing-course" class="inline-block border border-[var(--red)] px-8 py-4 font-mono text-white hover:bg-[var(--red-dark)] transition-colors w-full md:w-auto tracking-widest text-sm text-center">
        INITIATE: DIGITAL MARKETING
      </a>
    </div>
  </div>
</BaseLayout>
