---
interface Props {
  label: string;
  value: string;
  highlight?: boolean;
}
const { label, value, highlight = false } = Astro.props;
---
<div class={`pixel-panel p-6 flex flex-col justify-center border-l-4 ${highlight ? 'border-l-[var(--red)] bg-[var(--red-dark)]/20' : 'border-l-[var(--red-dark)]'}`}>
  <div class="font-mono text-xs md:text-sm text-[var(--text-muted)] mb-3 uppercase tracking-widest">{label}</div>
  <div class={`font-mono text-3xl md:text-4xl ${highlight ? 'text-[var(--red-bright)]' : 'text-white'}`}>{value}</div>
</div>
