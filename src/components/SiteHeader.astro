---
<header class="sticky top-0 z-50 bg-[var(--bg)]/95 backdrop-blur-lg border-b border-[var(--red-dark)] shadow-sm">
  <div class="case-study-container py-6 flex justify-between items-center">
    <div class="font-pixel text-[var(--red-bright)] tracking-tighter text-sm md:text-base drop-shadow-sm">
      <a href="/">KANISHK PRABHAT</a>
    </div>
    
    <nav class="hidden md:flex gap-12 text-sm font-mono text-[var(--text-secondary)] tracking-widest">
      <a href="/case-studies/dwell-construction" class="text-white border-b border-[var(--red)] pb-1 hover:text-[var(--red)] transition-colors">WORK</a>
      <a href="#" class="hover:text-white transition-colors pb-1">ABOUT</a>
    </nav>
    
    <a href="#" class="hidden md:inline-block bg-[var(--red-dark)]/30 border border-[var(--red)] text-white px-6 py-2.5 font-mono text-sm hover:bg-[var(--red)] hover:text-white transition-all duration-300 uppercase tracking-widest focus:ring-2 focus:ring-[var(--red)] focus:ring-offset-2 focus:ring-offset-[var(--bg)] outline-none">
      LET'S TALK
    </a>

    <!-- Mobile Menu Button -->
    <button class="md:hidden text-[var(--red-bright)] hover:text-white transition-colors" aria-label="Open Menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </button>
  </div>
</header>
